/* ═══════════════════════════════════════════════════════════════════
   DialogueEditorWindow.uss
   Styles for the outer window shell: toolbar, inspector panel,
   validation status bar, and the split-view layout.
   ═══════════════════════════════════════════════════════════════════ */

/* ── Root ──────────────────────────────────────────────────────── */

.editor-window-root {
    flex-direction: column;
    flex-grow:      1;
    background-color: #141623;
}

/* ── Toolbar ───────────────────────────────────────────────────── */

.editor-toolbar {
    background-color: #1a1d2e;
    border-bottom-color: #2d3052;
    border-bottom-width: 1px;
    padding:          0 8px;
    height:           32px;
    flex-shrink:      0;
    align-items:      center;
}

.toolbar-graph-field {
    min-width: 200px;
    max-width: 300px;
}

.toolbar-btn {
    color:            #c8cde8;
    background-color: transparent;
    border-color:     #3a3d5c;
    border-radius:    3px;
    padding:          2px 10px;
    margin:           0 2px;
    font-size:        11px;
}

.toolbar-btn:hover {
    background-color: #2a2d45;
    border-color:     #5b9cf6;
}

/* ── Main area split ───────────────────────────────────────────── */

.main-area {
    flex-grow:    1;
    flex-direction: row;
}

.graph-view-fill {
    flex-grow: 1;
}

/* ── Inspector panel ───────────────────────────────────────────── */

.inspector-panel {
    width:            320px;
    min-width:        260px;
    background-color: #1a1d2e;
    border-left-color: #2d3052;
    border-left-width: 1px;
    flex-direction:   column;
}

.inspector-header {
    font-size:        10px;
    -unity-font-style: bold;
    color:            #5b9cf6;
    letter-spacing:   2px;
    padding:          10px 12px 6px;
    border-bottom-color: #2d3052;
    border-bottom-width: 1px;
}

.inspector-empty-label {
    color:       #555880;
    font-size:   12px;
    -unity-text-align: middle-center;
    -unity-font-style: italic;
    flex-grow:   1;
    margin-top:  40px;
    white-space: normal;
}

.inspector-scroll {
    flex-grow: 1;
}

.inspector-content {
    padding: 8px 12px;
}

/* Sections */

.inspector-section {
    font-size:        10px;
    -unity-font-style: bold;
    color:            #8890b0;
    letter-spacing:   1px;
    margin-top:       10px;
    margin-bottom:    4px;
    border-bottom-color: #2a2d45;
    border-bottom-width: 1px;
    padding-bottom:   3px;
}

.subsection-label {
    font-size:  10px;
    color:      #6670a0;
    margin-top: 6px;
    margin-bottom: 2px;
    -unity-font-style: bold;
}

/* Rows */

.inspector-row {
    flex-direction: row;
    align-items:    center;
    margin-bottom:  5px;
}

.inspector-field-label {
    color:       #8890b0;
    font-size:   10px;
    width:       110px;
    flex-shrink: 0;
}

.inspector-field {
    flex-grow: 1;
}

.inspector-field > .unity-text-field__input,
.inspector-field > .unity-float-field__input {
    background-color: #111320;
    border-color:     #3a3d5c;
    border-radius:    3px;
    color:            #c8cde8;
    font-size:        11px;
    padding:          2px 6px;
}

.inspector-textarea {
    margin-bottom: 6px;
}

.inspector-textarea > .unity-text-field__input {
    background-color: #111320;
    border-color:     #3a3d5c;
    border-radius:    3px;
    color:            #c8cde8;
    font-size:        11px;
    padding:          4px 6px;
    white-space:      normal;
    min-height:       72px;
}

.inspector-toggle {
    color:         #8890b0;
    font-size:     11px;
    margin-bottom: 4px;
}

.readonly-value {
    color:     #5b9cf6;
    font-size: 11px;
}

/* Choices */

.choice-list {
    margin-bottom: 4px;
}

.choice-card {
    background-color: #1e2236;
    border-color:     #2d3052;
    border-width:     1px;
    border-radius:    4px;
    padding:          6px 8px;
    margin-bottom:    6px;
}

.choice-card-header {
    flex-direction:  row;
    align-items:     center;
    justify-content: space-between;
    margin-bottom:   4px;
}

.choice-card-title {
    color:        #c07c1a;
    font-size:    10px;
    -unity-font-style: bold;
}

/* Conditions */

.condition-row {
    flex-direction: row;
    align-items:    center;
    margin-bottom:  4px;
    flex-wrap:      wrap;
}

.condition-type {
    width:      130px;
    flex-shrink: 0;
    margin-right: 4px;
}

.condition-field {
    flex-grow:    1;
    min-width:    60px;
    margin-right: 4px;
}

.condition-field > .unity-text-field__input {
    background-color: #111320;
    border-color:     #3a3d5c;
    border-radius:    3px;
    color:            #c8cde8;
    font-size:        10px;
    padding:          1px 4px;
}

.condition-negate {
    width:    30px;
    flex-shrink: 0;
    font-size: 10px;
    color:    #8890b0;
}

/* Buttons */

.add-btn {
    background-color: #1e3a5f;
    border-color:     #2d5a9e;
    border-radius:    4px;
    color:            #5b9cf6;
    font-size:        11px;
    padding:          4px;
    margin-top:       4px;
    margin-bottom:    8px;
}

.add-btn:hover {
    background-color: #2d5a9e;
    color:            #ffffff;
}

.add-btn-small {
    background-color: #111320;
    border-color:     #2d3052;
    border-radius:    3px;
    color:            #5b9cf6;
    font-size:        10px;
    padding:          2px 6px;
    margin-top:       2px;
}

.remove-btn {
    color:            #b03030;
    background-color: transparent;
    border-color:     #3a1010;
    border-radius:    3px;
    font-size:        10px;
    padding:          0 4px;
    width:            20px;
    height:           20px;
}

.remove-btn:hover {
    background-color: #3a1010;
}

.inspector-empty-small {
    color:       #555880;
    font-size:   10px;
    -unity-font-style: italic;
    margin-bottom: 4px;
}

/* ── Locale dropdown (toolbar) ─────────────────────────────────── */

.toolbar-locale-label {
    color:       #8890b0;
    font-size:   11px;
    margin-left: 4px;
    margin-right: 4px;
    -unity-text-align: middle-left;
}

.toolbar-locale-dropdown {
    min-width:   110px;
    margin:      0 4px;
}

.toolbar-locale-dropdown .unity-base-field__label {
    display: none;   /* hide the built-in label; we use toolbar-locale-label */
}

.toolbar-locale-dropdown .unity-base-popup-field__input {
    background-color: #1e2236;
    border-color:     #3a3d5c;
    border-radius:    3px;
    color:            #5b9cf6;
    font-size:        11px;
    padding:          1px 6px;
}

.toolbar-btn--warn {
    color:        #e08050;
    border-color: #5a3010;
}

/* ── Locale fields (inspector panel) ───────────────────────────── */

.locale-block {
    margin-bottom: 6px;
}

.locale-row {
    flex-direction: row;
    align-items:    flex-start;
    margin-bottom:  4px;
}

/* Locale code badge: "EN", "FR", etc. */
.locale-badge {
    width:             28px;
    min-width:         28px;
    font-size:         9px;
    -unity-font-style: bold;
    color:             #ffffff;
    background-color:  #2d3a5a;
    border-color:      #3d5090;
    border-width:      1px;
    border-radius:     3px;
    padding:           2px 3px;
    margin-right:      6px;
    margin-top:        2px;
    -unity-text-align: middle-center;
    flex-shrink:       0;
}

.locale-field {
    flex-grow: 1;
}

.locale-field > .unity-text-field__input {
    background-color: #111320;
    border-color:     #3a3d5c;
    border-radius:    3px;
    color:            #c8cde8;
    font-size:        11px;
    padding:          2px 6px;
}

.locale-textarea {
    flex-grow: 1;
}

.locale-textarea > .unity-text-field__input {
    background-color: #111320;
    border-color:     #3a3d5c;
    border-radius:    3px;
    color:            #c8cde8;
    font-size:        11px;
    padding:          4px 6px;
    white-space:      normal;
    min-height:       56px;
}

/* Key field — shows the raw StringTable key */
.key-field > .unity-text-field__input {
    background-color: #0e1020;
    border-color:     #2a3060;
    border-radius:    3px;
    color:            #5b9cf6;
    font-size:        10px;
    padding:          2px 6px;
    -unity-font-style: italic;
}

.locale-warning {
    color:        #e08050;
    font-size:    10px;
    margin-bottom: 6px;
}

/* ── Validation bar ─────────────────────────────────────────────── */

.validation-panel {
    background-color:  #141623;
    border-top-color:  #2d3052;
    border-top-width:  1px;
    flex-shrink:       0;
    max-height:        140px;
}

.validation-bar {
    flex-direction:  row;
    align-items:     center;
    padding:         4px 12px;
    min-height:      26px;
}

.validation-status {
    flex-grow:  1;
    font-size:  11px;
    color:      #8890b0;
}

.validation-ok    { color: #4caf73; }
.validation-error { color: #e05050; }

.validation-toggle-btn {
    color:            #8890b0;
    background-color: transparent;
    border-color:     transparent;
    font-size:        10px;
    padding:          0 4px;
}

.validation-error-list {
    padding:    0 12px 6px;
    max-height: 110px;
    overflow:   scroll;
}

.validation-error-item {
    color:        #e08050;
    font-size:    10px;
    margin-bottom: 2px;
}
